{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true,
    "inlineSources": true,
    "baseUrl": ".",
    "paths": {
      "@index": ["src/index.ts"],
      "@index/*": ["src/*"],
      "@shared": ["src/shared/index.ts"],
      "@shared/*": ["src/shared/*"],
      "@utils": ["src/utils/index.ts"],
      "@utils/*": ["src/utils/*"],
      "@services": ["src/services/index.ts"],
      "@services/*": ["src/services/*"],
      "@workers": ["src/workers/index.ts"],
      "@workers/*": ["src/workers/*"]
    },
    "sourceRoot": "./"
  },
  "include": ["**/**/*.ts"],
  "exclude": ["node_modules"]
}
